# Load explicitly with node --env-file=.env server.js; never commit .env.
PORT=5000
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_ALLOW_INSECURE_LOCAL=true
MQTT_USERNAME=backend
MQTT_PASSWORD=replace-with-generated-password
IOT_API_TOKEN=replace-with-random-token-at-least-32-characters
IOT_DEVICE_IDS=esp32-01
# Simulation must not alter real dashboard totals unless explicitly requested.
IOT_SIMULATION_TO_DASHBOARD=false

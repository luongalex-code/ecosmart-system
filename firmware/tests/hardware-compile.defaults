# COMPILE ONLY: NOT a wiring confirmation, calibration or deployable board configuration.
CONFIG_IDF_TARGET="esp32"
# CONFIG_SW_SIMULATION is not set
CONFIG_SW_WIRING_REVIEWED=y
CONFIG_SW_MOTION_CALIBRATED=y
CONFIG_SW_LCD_CONFIRMED=y
CONFIG_SW_LCD_SDA=-1
CONFIG_SW_LCD_SCL=-1
CONFIG_SW_WIFI_SSID="COMPILE_ONLY_DO_NOT_FLASH"
CONFIG_SW_WIFI_PASSWORD="COMPILE_ONLY_DO_NOT_FLASH"
CONFIG_SW_MQTT_URI="mqtt://127.0.0.1:18883"
CONFIG_SW_ALLOW_PLAINTEXT_MQTT=y
CONFIG_SW_HX711_COUNTS_PER_KG=100000
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
